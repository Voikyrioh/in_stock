{
	"name": "@in-stock/server",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "STORAGE=${STORAGE:-postgres} OTEL_SDK_DISABLED=${OTEL_SDK_DISABLED:-true} tsx watch src/index.ts",
		"build": "node build.mjs",
		"start": "node --enable-source-maps --import @Voikyrioh/observability/register dist/index.js",
		"typecheck": "tsc --noEmit -p .",
		"test": "mocha",
		"probe": "OTEL_SDK_DISABLED=true tsx src/tools/probe.ts"
	},
	"dependencies": {
		"@hono/node-server": "^1.19.17",
		"@hono/zod-validator": "^0.9.1",
		"@Voikyrioh/observability": "^0.5.0",
		"argon2": "^0.45.1",
		"cheerio": "^1.2.0",
		"hono": "^4.13.13",
		"pg": "^8.23.1",
		"robots-parser": "^3.0.1",
		"ulid": "^3.0.2",
		"undici": "^8.12.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@in-stock/shared": "*",
		"@types/chai": "^5.2.3",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.19.0",
		"@types/pg": "^8.23.1",
		"chai": "^5.3.3",
		"esbuild": "^0.28.2",
		"mocha": "^11.8.0",
		"pino-pretty": "^13.2.0",
		"tsx": "^4.23.15"
	}
}
