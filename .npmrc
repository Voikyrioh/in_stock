# Private packages of the @Voikyrioh scope (GitHub Packages): a token with
# read:packages is read from GITHUB_TOKEN. CI and Docker builds pass the repo
# secret NPM_TOKEN (or the workflow token once the package grants this
# repository read access). Never put the token itself in this file.
@Voikyrioh:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
