# Server (see server/src/config/index.ts). Copy to server/.env or export.
NODE_ENV=development
HOSTNAME=127.0.0.1
PORT=3000
# memory = no database (everything is lost at restart), postgres = DATABASE_URL required
STORAGE=postgres
DATABASE_URL=postgres://in_stock:in_stock@127.0.0.1:5432/in_stock
MIGRATIONS_DIR=migrations
LOG_LEVEL=info
# No OpenTelemetry collector in development
OTEL_SDK_DISABLED=true
# Robot: page announced in the User-Agent (InStockBot/1.0 (+<url>))
SCRAPER_CONTACT_URL=http://localhost:5173/robot
# Comma separated shop ids to disable, e.g. amazon,cdiscount
DISABLED_SHOPS=
# Background refresh of followed products (false to disable in development)
SCHEDULER_ENABLED=true
# Production only (set by the infra app sheet):
# PUBLIC_ORIGIN=https://in-stock.voikyrioh.fr
# OTEL_SERVICE_NAME=in-stock
# OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-otel-collector:4318
# STATIC_DIR=/app/public
